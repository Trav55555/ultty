---
source: crates/ulttui/tests/snapshots.rs
expression: out
---
Button+description: r1 button "Run" desc="Runs tests"
Checkbox: r1 checkbox "Accept" toggled=True
Toggle: r1 switch "Dark mode" toggled=False
ErrorState: r1 alert "Error: disk full" desc="free space"
Badge: r1 status "Done"
Title: r1 heading level=1
Section: r1 group "Files"
Section: r2 heading level=2
Divider: r1 auto hidden
Spacer: r1 auto hidden
Image: r1 image "A red dot"
TextInput: r1 input "Message" desc="Type" value_text=""
Select: r1 list "Letter" expanded=Collapsed value_text="a" pos=1/2
List: r1 list "Numbers"
List: r2 list_item pos=1/2
List: r3 list_item pos=2/2
Tabs: r1 tab_list
Tabs: r2 tab "Log" pos=1/2
Tabs: r3 tab "Diff" pos=2/2
Tree: r1 tree "Files"
Tree: r2 tree_item "src" expanded=Expanded level=1
Tree: r3 auto hidden
Tree: r4 auto hidden
Tree: r5 auto hidden
Tree: r6 tree_item "main.rs" level=2
Tree: r7 auto hidden
Tree: r8 auto hidden
Tree: r9 auto hidden
Collapsible: r1 tree_item expanded=Collapsed
Collapsible: r3 auto hidden
Modal: r1 dialog "Delete?" modal
Modal: r4 button "Yes"
Modal: r5 button "No"
MarkdownView+streaming: r1 log live=polite busy
MarkdownView+streaming: r2 auto live=polite
Semantic: r1 log "Messages" live=polite
