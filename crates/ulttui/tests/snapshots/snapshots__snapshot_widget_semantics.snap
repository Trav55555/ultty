---
source: crates/ulttui/tests/snapshots.rs
expression: out
---
Button+description: r1 button "Run" desc="Runs tests"
Checkbox: r1 checkbox "Accept" toggled=True
Toggle: r1 switch "Dark mode" toggled=False
ErrorState: r1 alert "Error: disk full" desc="free space"
Badge: r1 status "Done"
Title: r1 heading level=1
Section: r1 group "Files"
Section: r2 heading level=2
Divider: r1 auto hidden
Spacer: r1 auto hidden
Image: r1 image "A red dot"
TextInput: r1 input "Message" desc="Type. vim normal mode" value_text=""
TextInput+password: r1 input desc="vim normal mode"
Select: r1 combo_box "Letter" expanded=Collapsed value_text="a"
Select+expanded: r1 combo_box "Letter" expanded=Expanded value_text="b"
Select+expanded: r2 option "a" pos=1/2
Select+expanded: r3 auto hidden
Select+expanded: r4 option "b" selected pos=2/2
Select+expanded: r5 auto hidden
List: r1 list "Numbers"
List: r2 list_item selected pos=1/2
List: r3 list_item pos=2/2
Tabs: r1 tab_list
Tabs: r2 tab "Log" pos=1/2
Tabs: r3 tab "Diff" selected pos=2/2
Tree: r1 tree "Files"
Tree: r2 tree_item "src" selected expanded=Expanded level=1
Tree: r3 auto hidden
Tree: r4 auto hidden
Tree: r5 auto hidden
Tree: r6 tree_item "main.rs" level=2
Tree: r7 auto hidden
Tree: r8 auto hidden
Tree: r9 auto hidden
Table: r1 table
Table: r2 row pos=1/3
Table: r3 column_header pos=1/2
Table: r4 column_header pos=2/2
Table: r5 row selected pos=2/3
Table: r6 cell pos=1/2
Table: r7 cell pos=2/2
Table: r8 row pos=3/3
Table: r9 cell pos=1/2
Table: r10 cell pos=2/2
Collapsible: r1 tree_item expanded=Collapsed
Collapsible: r3 auto hidden
Modal: r1 dialog "Delete?" modal
Modal: r4 button "Yes"
Modal: r5 button "No"
MarkdownView+streaming: r1 log live=polite busy
MarkdownView+streaming: r2 auto live=polite
Semantic: r1 log "Messages" live=polite
